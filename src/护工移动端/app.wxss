page {
  min-height: 100%;
  background: linear-gradient(180deg, #f6faff 0%, #eef5fb 100%);
  color: #203044;
  font-size: 28rpx;
  line-height: 1.6;
}

view,
text,
button,
input,
textarea,
picker,
switch,
scroll-view {
  box-sizing: border-box;
}

button::after {
  border: none;
}

.container {
  padding: 28rpx 24rpx 36rpx;
}

.with-tabbar-space {
  padding-bottom: 180rpx;
}

.main-tab-page {
  padding-top: 52rpx;
}

.card {
  position: relative;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.97);
  border: 1rpx solid rgba(148, 163, 184, 0.14);
  border-radius: 30rpx;
  padding: 32rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 16rpx 38rpx rgba(39, 76, 119, 0.09);
}

.title {
  font-size: 44rpx;
  line-height: 1.25;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #15324b;
}

.subtitle {
  font-size: 25rpx;
  color: #718096;
  margin-top: 10rpx;
}

.section-title {
  position: relative;
  padding-left: 18rpx;
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 700;
  margin-bottom: 20rpx;
  color: #18364f;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 7rpx;
  width: 6rpx;
  height: 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #2f80ed 0%, #21b6a8 100%);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.section-header .section-title {
  margin-bottom: 0;
}

.link-text {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #2475d0;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.grid-col-2 {
  width: 50%;
  padding: 0 8rpx;
}

.small-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(145deg, #f9fcff 0%, #f1f7fd 100%);
  border: 1rpx solid #e6eff8;
  border-radius: 22rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  min-height: 150rpx;
}

.small-card::after {
  content: '';
  position: absolute;
  right: -28rpx;
  top: -30rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(47, 128, 237, 0.06);
}

.warning-soft {
  background: linear-gradient(145deg, #fff9f4 0%, #fff3ee 100%);
  border-color: #ffe2d6;
}

.warning-soft::after {
  background: rgba(225, 76, 70, 0.07);
}

.kpi-value {
  position: relative;
  z-index: 1;
  font-size: 42rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #15324b;
  word-break: break-all;
}

.kpi-label {
  position: relative;
  z-index: 1;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #718096;
}

.btn-row {
  display: flex;
  margin-top: 24rpx;
}

.btn-row .btn-primary,
.btn-row .btn-secondary,
.btn-row .btn-danger,
.btn-row .btn-outline,
.btn-row .mini-btn,
.btn-row .mini-btn-danger {
  flex: 1;
}

.btn-row .btn-primary + .btn-secondary,
.btn-row .btn-primary + .btn-danger,
.btn-row .btn-primary + .btn-outline,
.btn-row .btn-secondary + .btn-primary,
.btn-row .btn-secondary + .btn-danger,
.btn-row .btn-secondary + .btn-outline,
.btn-row .btn-danger + .btn-primary,
.btn-row .btn-danger + .btn-secondary,
.btn-row .btn-danger + .btn-outline,
.btn-row .btn-outline + .btn-primary,
.btn-row .btn-outline + .btn-secondary,
.btn-row .btn-outline + .btn-danger,
.btn-row .mini-btn + .mini-btn-danger,
.btn-row .mini-btn-danger + .mini-btn,
.btn-row .mini-btn + .btn-primary,
.btn-row .btn-primary + .mini-btn {
  margin-left: 16rpx;
}

.btn-primary,
.btn-secondary,
.btn-danger,
.btn-outline {
  min-height: 84rpx;
  margin: 0;
  border-radius: 22rpx;
  padding: 19rpx 24rpx;
  text-align: center;
  font-size: 27rpx;
  font-weight: 600;
  border: none;
  line-height: 1.4;
}

.mini-btn,
.mini-btn-danger {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 148rpx;
  height: 72rpx;
  margin: 0;
  border-radius: 18rpx;
  font-size: 24rpx;
  font-weight: 600;
  padding: 0 20rpx;
}

.mini-btn {
  background: #edf5ff;
  color: #245b8e;
}

.mini-btn-danger {
  background: linear-gradient(135deg, #e4554f 0%, #cf3434 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(207, 52, 52, 0.18);
}

.btn-primary {
  background: linear-gradient(135deg, #2f80ed 0%, #2475d0 100%);
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(47, 128, 237, 0.18);
}

.btn-secondary {
  background: #eef5fb;
  color: #34536f;
}

.btn-danger {
  background: linear-gradient(135deg, #e4554f 0%, #cf3434 100%);
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(207, 52, 52, 0.18);
}

.btn-outline {
  background: #ffffff;
  color: #2475d0;
  border: 1rpx solid #bdd9f5;
}

.list-item {
  padding: 24rpx 2rpx;
  border-bottom: 1rpx solid #edf2f7;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item-title {
  font-size: 29rpx;
  line-height: 1.45;
  font-weight: 700;
  color: #18364f;
}

.list-item-desc {
  font-size: 25rpx;
  color: #718096;
  margin-top: 8rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.row > view:first-child,
.section-header > view:first-child {
  min-width: 0;
}

.align-start {
  align-items: flex-start;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.tag {
  background: #eef5fb;
  color: #46627b;
  border: 1rpx solid #e0ebf5;
  border-radius: 999rpx;
  padding: 7rpx 17rpx;
  font-size: 21rpx;
  margin-right: 12rpx;
  margin-top: 12rpx;
}

.tag-red {
  background: #fff0ef;
  color: #c83e3a;
  border-color: #ffd7d3;
}

.tag-green {
  background: #eaf8f2;
  color: #277a5c;
  border-color: #cfeee0;
}

.tag-yellow {
  background: #fff7e6;
  color: #a46d16;
  border-color: #f5e0b6;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 25rpx;
  font-weight: 600;
  color: #38536d;
  margin-bottom: 14rpx;
}

.input,
.picker,
.textarea {
  width: 100%;
  background: #ffffff;
  border: 2rpx solid #d8e6f2;
  border-radius: 22rpx;
  font-size: 27rpx;
  color: #18364f;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9), 0 6rpx 16rpx rgba(36, 74, 110, 0.04);
}

.input {
  display: block;
  height: 92rpx;
  line-height: 92rpx;
  padding: 0 26rpx;
}

.picker {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 92rpx;
  padding: 0 60rpx 0 26rpx;
  line-height: 1.45;
}

.picker::after {
  content: '';
  position: absolute;
  right: 28rpx;
  top: 50%;
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #8ba0b5;
  border-bottom: 3rpx solid #8ba0b5;
  transform: translateY(-65%) rotate(45deg);
}

.textarea {
  min-height: 220rpx;
  line-height: 1.7;
  padding: 24rpx 26rpx;
}

.placeholder {
  color: #9aaabd;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -6rpx 16rpx;
}

.filter-chip {
  padding: 11rpx 20rpx;
  border-radius: 999rpx;
  margin: 0 6rpx 12rpx;
  background: #eef3f8;
  border: 1rpx solid #e1eaf2;
  color: #60758b;
  font-size: 23rpx;
}

.filter-chip.active {
  background: linear-gradient(135deg, #e4f1ff 0%, #e9f8f5 100%);
  border-color: #b9d9f2;
  color: #236cae;
  font-weight: 600;
}

.empty-wrap {
  padding: 54rpx 20rpx;
  text-align: center;
  color: #93a4b6;
}

.fixed-action {
  position: fixed;
  right: 24rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  padding: 10rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 14rpx 36rpx rgba(36, 74, 110, 0.14);
}

.notice {
  background: linear-gradient(135deg, #f2f8ff 0%, #ffffff 58%, #effaf7 100%);
  border-color: #d6e8f7;
}

.notice::after {
  content: '';
  position: absolute;
  right: -52rpx;
  top: -58rpx;
  width: 170rpx;
  height: 170rpx;
  border-radius: 50%;
  background: rgba(47, 128, 237, 0.06);
}

.notice-danger {
  background: linear-gradient(135deg, #fff4f2 0%, #ffffff 68%, #fff7f3 100%);
  border-color: #ffd9d5;
}

.notice-danger .section-title::before {
  background: linear-gradient(180deg, #ef6c64 0%, #cf3434 100%);
}

.muted {
  color: #718096;
}

.danger-text {
  color: #cf3434;
}

.time-text {
  flex-shrink: 0;
  font-size: 21rpx;
  color: #8a9aab;
}

.done-text {
  text-decoration: line-through;
}

.no-border {
  border-bottom: none;
}

.mb-0 {
  margin-bottom: 0;
}

.mt-8 {
  margin-top: 8rpx;
}

.mt-16 {
  margin-top: 16rpx;
}

.mt-24 {
  margin-top: 24rpx;
}

.pt-0 {
  padding-top: 0;
}

.form-panel {
  padding-top: 34rpx;
}

.form-submit-btn {
  display: block;
  width: 60%;
  margin: 14rpx auto 2rpx;
}
